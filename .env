# ─── API Keys ────────────────────────────────────────────────
# Get from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Get from: https://aistudio.google.com/ (optional, only if using Gemini)
# GEMINI_API_KEY=your_gemini_api_key_here


# ─── Paths (optional — defaults to standard Windows user folders) ─
# Absolute path to this project's folder
# JARVIS_PROJECT_DIR=C:/path/to/your/jarvis

# Where screenshots are saved (defaults to %USERPROFILE%/Pictures/Screenshots)
# JARVIS_SCREENSHOTS_DIR=C:/path/to/screenshots

# Where notes are saved (defaults to %USERPROFILE%/Desktop/jarvis_notes.txt)
# JARVIS_NOTES_PATH=C:/path/to/jarvis_notes.txt
